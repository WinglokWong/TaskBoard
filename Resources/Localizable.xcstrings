    "# 标题、- 列表、- [ ] 任务、**粗体**、*斜体*、`代码`、[链接](https://…)、> 引用、``` 代码块": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# heading, - list, - [ ] task, **bold**, *italic*, `code`, [link](https://…), > quote, ``` code block"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "# 標題、- 列表、- [ ] 任務、**粗體**、*斜體*、`程式碼`、[連結](https://…)、> 引用、``` 程式碼區塊"
          }
        }
      }
    },
    "%@ %@": {
